#!/usr/bin/env python3

import argparse
import logging
import json
import os
import sys

import matplotlib.pyplot as plt
import ruamel.yaml

from opusfilter.curriculum_learning import BabyStep
from opusfilter.autogen import ConfigurationGenerator
from opusfilter.opusfilter import OpusFilter

try:
    plt.style.use('seaborn-v0_8')
except OSError:
    pass

logger = logging.getLogger(__name__)

logging.basicConfig(level=logging.INFO)
logging.getLogger('mosestokenizer.tokenizer.MosesTokenizer').setLevel(logging.WARNING)

parser = argparse.ArgumentParser(
    prog='opusfilter-curriculum',
    description='Create a curriculum learning schedule for a dataset')

parser.add_argument('--scores', required=True, metavar='SCOREFILE', help='jsonl score file')
parser.add_argument('--method', choices=['babystep'], default='babystep',
                    help='Curriulum method (default: %(default)s)')
parser.add_argument('--sample-size', default=100000, type=int, metavar='INT',
                    help='Max number of sentence pairs used for data-based methods (default %(default)s)')
parser.add_argument('--clusters', '-k', default=5, type=int, metavar='INT',
                    help=('Number of clusters for Kmeans clustering (default %(default)s)'))
parser.add_argument('--seed', default=1, help='Seed for subset')
parser.add_argument('--work-dir', default='work', help='Location of the source and target files (default %(default)s)')
parser.add_argument('--overwrite', action='store_true',
                    help='Overwrite existing intermediate files')
parser.add_argument('-o', '--output', type=argparse.FileType('w'),
                    default='-', metavar='OUTPUTFILE', help='Output file (default %(default)s)')
args = parser.parse_args()

if args.method == 'babystep':
    config_gen = ConfigurationGenerator(files=[args.scores], workdir=args.work_dir)
    config_gen.add_subset(args.sample_size, 1, prefix=f'sample.{args.scores}')
    config = config_gen.get_config()
    opusf = OpusFilter(config)
    opusf.execute_steps(overwrite=args.overwrite)
    
    babystep = BabyStep(os.path.join(args.work_dir, f'sample.{args.scores}.1.gz'), k=args.clusters, output_file=args.output, workdir=args.work_dir)
    babystep.classify(os.path.join(args.work_dir, args.scores))
